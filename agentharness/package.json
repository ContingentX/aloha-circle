    "test:live": "node --test test/live/*.test.js"
  },
  "dependencies": {
    "@brightdata/mcp": "2.11.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "zod": "3.25.76"
  }
}
