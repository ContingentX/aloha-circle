{
  "name": "alohalive-agentharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Aloha Agent: API, continuous Maui Needs Index ingest, and matcher",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "trueforge:agent": "node src/configure-agent.js",
    "ingest": "node src/index.js --ingest-once",
    "demo:brightdata-bridge": "node demo/brightdata-mcp-bridge.mjs",
    "smoke:brightdata-bridge": "node demo/brightdata-bridge-smoke.mjs",
    "test": "node --test test/*.test.js",
