rules_version = '2';

// Rules for bucket contingentx-alohalive (verification uploads).
// Deploy: see infra/README-firebase.md
service firebase.storage {
  match /b/{bucket}/o {
    // Residency-proof documents (bill photos): owner-only, images, <10 MB.
    // Reviewers read via the console/Admin SDK.
    match /verify/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
